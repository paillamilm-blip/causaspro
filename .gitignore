node_modules
.next

# Variables de entorno: el .env tiene el RUT, la clave de Clave Unica y la
# service role key. El patron .env.* cubre TAMBIEN los derivados (.env.local y
# el .env.respaldo que genera bot-mantenimiento.bat antes de tocar el archivo):
# sin eso, el respaldo quedaba fuera del ignore y podia subirse con credenciales.
.env
.env.*
!.env.example

# Scripts .bat con secretos (RUT, contraseña PJUD, service role key).
# NO versionar: contienen credenciales. Usar los .bat.example como plantilla.
*.bat
!*.bat.example
# Artefactos de review (generados, no versionar)
semantic-review/

# TypeScript build info (generado, no versionar)
*.tsbuildinfo

# Capturas de debug del bot (generadas en cada corrida, no versionar)
bot-capturas/

# Lock y logs de las tandas del bot (generados, no versionar)
*.lock
*-log.txt
