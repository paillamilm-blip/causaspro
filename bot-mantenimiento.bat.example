@echo off
setlocal
cd /d "%~dp0"
title CausasPro - Mantenimiento diario

REM ============================================================
REM CausasPro - BOT PJUD: MANTENIMIENTO DIARIO (un solo clic)
REM ============================================================
REM
REM QUE HACE: trae los movimientos nuevos de 25 causas. Primero las que
REM todavia no tienen datos y, si sobra cupo, refresca las mas viejas.
REM
REM COMO SE USA: doble clic. Nada mas.
REM
REM   - La PRIMERA vez te pregunta 3 datos (RUT, clave, llave de Supabase)
REM     y los guarda en el archivo .env.
REM   - De ahi en adelante arranca directo, sin preguntar nada.
REM
REM Es de BAJO PERFIL a proposito (menos riesgo con el portal):
REM   - Solo 25 causas, UNA tanda (sin rafagas).
REM   - Solo corre entre las 8 y las 18 h (hora de Chile). Fuera de ese
REM     horario se cancela solo: correr de dia parece uso normal.
REM
REM SI CAMBIAS LA CLAVE UNICA: borra el archivo .env y volve a hacer
REM doble clic; te va a preguntar los datos de nuevo.
REM ============================================================

echo ============================================================
echo   CausasPro - MANTENIMIENTO DIARIO
echo ============================================================
echo.

REM ---------- 1) Esta Node.js instalado? ----------
where node >nul 2>nul
if errorlevel 1 goto :falta_node

REM ---------- 2) Hay credenciales guardadas? ----------
if not exist ".env" goto :configurar
findstr /b /c:"PJUD_RUT=" ".env" >nul 2>nul
if errorlevel 1 goto :configurar
goto :hay_config

REM ============================================================
REM PRIMERA VEZ: pedir los datos y guardarlos en .env
REM ============================================================
:configurar
echo ------------------------------------------------------------
echo   CONFIGURACION INICIAL (solo esta vez)
echo ------------------------------------------------------------
echo.
echo Te voy a pedir 3 datos. Se guardan en este PC, en el archivo
echo .env, y no se suben a internet ni a GitHub.
echo.

echo 1 de 3) Tu RUT para Clave Unica
echo         Escribilo con guion y sin puntos. Ejemplo: 17692174-9
set "CFG_RUT="
set /p "CFG_RUT=RUT: "
if not defined CFG_RUT goto :dato_vacio
echo.

echo 2 de 3) Tu contrasena de Clave Unica
echo         No se va a ver nada mientras la escribis. Es normal.
echo         Podes pegarla con clic derecho. Apreta Enter al terminar.
set "CFG_PASS="
REM El prompt se imprime aca (sin salto de linea) porque Read-Host no puede
REM mostrarlo: su salida la captura el for /f.
<nul set /p "=Contrasena: "
for /f "delims=" %%P in ('powershell -NoProfile -Command "$s=Read-Host -AsSecureString; [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR($s))"') do set "CFG_PASS=%%P"
if not defined CFG_PASS goto :dato_vacio
echo.
echo.

echo 3 de 3) La llave de Supabase (service role key)
echo         Es un texto largo. Pegalo con clic derecho.
echo         Lo saco de: Supabase ^> Settings ^> API ^> service_role
set "CFG_KEY="
set /p "CFG_KEY=Llave: "
if not defined CFG_KEY goto :dato_vacio
echo.

REM Se escribe el .env con PowerShell (no con echo) para que no se rompa
REM si la contrasena tiene simbolos como & o ^. El [char]34 son las comillas:
REM loadEnv.ts acepta valores entre comillas, asi que soporta espacios.
REM Guardar en .env. Detalles que importan:
REM  - Se escribe con PowerShell y NO con echo, porque echo se rompe si la clave
REM    tiene & o ^. Las comillas se ponen con [char]34 para no pelear con el
REM    escapado de cmd.
REM  - UTF8 (no ASCII) para no romper la ene ni las tildes de la clave. El BOM
REM    cae en la linea de comentario, que loadEnv.ts ignora.
REM  - CONSERVA el .env que ya existiera: solo reemplaza las 4 claves que maneja
REM    este script y deja intacto todo lo demas (por ejemplo IMAP_* o
REM    CONFIG_ENCRYPT_KEY). Antes de tocar nada deja una copia en .env.respaldo.
if exist ".env" copy /y ".env" ".env.respaldo" >nul 2>nul
powershell -NoProfile -Command "$q=[char]34; $mias=@('PJUD_RUT','PJUD_PASSWORD','NEXT_PUBLIC_SUPABASE_URL','SUPABASE_SERVICE_ROLE_KEY'); $previas=@(); if (Test-Path '.env') { $previas = Get-Content '.env' | Where-Object { $linea = $_.Trim(); -not ($mias | Where-Object { $linea -like ($_ + '=*') }) } }; $nuevas=@(('PJUD_RUT=' + $q + $env:CFG_RUT + $q), ('PJUD_PASSWORD=' + $q + $env:CFG_PASS + $q), 'NEXT_PUBLIC_SUPABASE_URL=https://ggwpikokzhckjpwyltye.supabase.co', ('SUPABASE_SERVICE_ROLE_KEY=' + $q + $env:CFG_KEY + $q)); $salida=@('# CausasPro - credenciales del bot. NO subir a git.') + $nuevas; if ($previas.Count -gt 0) { $salida = $salida + '' + $previas }; Set-Content -Path '.env' -Value $salida -Encoding UTF8"
if errorlevel 1 goto :error_guardar
if not exist ".env" goto :error_guardar

REM Borrar las variables de memoria: de aca en mas el bot lee el .env.
set "CFG_RUT="
set "CFG_PASS="
set "CFG_KEY="

echo Datos guardados. No te los voy a volver a pedir.
echo.

:hay_config

REM ---------- 3) Estan instaladas las dependencias? ----------
if not exist "node_modules" (
  echo Primera preparacion: instalando lo que necesita el bot.
  echo Esto puede tardar unos minutos. No cierres la ventana.
  echo.
  call npm install
  if errorlevel 1 goto :error_install
  echo.
)

REM ---------- 4) Traer las ultimas mejoras (si se puede) ----------
where git >nul 2>nul
if not errorlevel 1 (
  echo Buscando mejoras del programa...
  git pull >nul 2>nul
  if errorlevel 1 (
    echo    ^(No se pudieron traer mejoras ahora. No importa, sigo.^)
  ) else (
    echo    Listo.
  )
  echo.
)

REM ---------- 5) Candado: que no corran dos bots a la vez ----------
REM Comparte candado con bot-100-causas.bat: dos bots con el mismo RUT a la
REM vez es justo lo que hace que el portal marque el bot.
if exist "bot-100-causas.lock" (
  tasklist /fi "imagename eq node.exe" 2>nul | find /i "node.exe" >nul
  if errorlevel 1 (
    echo Habia un candado viejo de una corrida que se corto. Lo limpio y sigo.
    del "bot-100-causas.lock" 2>nul
    echo.
  ) else (
    echo ------------------------------------------------------------
    echo   YA HAY UN BOT CORRIENDO
    echo ------------------------------------------------------------
    echo   Espera que termine el otro y volve a intentar.
    echo.
    pause
    exit /b 0
  )
)
echo running > "bot-100-causas.lock"

REM ---------- 6) Configuracion de esta corrida ----------
REM 25 causas: bajo perfil.
set "BOT_MAX_CAUSAS=25"
REM Modo 'rit': revisa las causas YA cargadas. NUNCA cambiar a 'listado'.
set "BOT_SEARCH_MODE=rit"
REM NO se setea SKIP_HOUR_CHECK: el bot solo corre entre 8 y 18 h.

REM Si falla la descarga de Chromium, descomenta la linea de abajo para
REM usar el Chrome que ya tenes instalado:
REM set "BOT_USE_SYSTEM_CHROME=1"

echo ============================================================
echo   Arrancando (25 causas, horario 8 a 18 h)
echo   NO CIERRES ESTA VENTANA hasta que termine.
echo ============================================================
echo.

echo [%date% %time%] Iniciando...
call npm run bot
set "RESULTADO=%errorlevel%"
echo [%date% %time%] Terminado.

del "bot-100-causas.lock" 2>nul

echo.
if not "%RESULTADO%"=="0" goto :termino_con_error
echo ============================================================
echo   LISTO - Ya podes cerrar esta ventana.
echo   Revisa el panel en causaspro.vercel.app
echo ============================================================
echo.
pause
exit /b 0

REM ============================================================
REM MENSAJES DE ERROR
REM ============================================================
:falta_node
echo ------------------------------------------------------------
echo   FALTA INSTALAR NODE.JS
echo ------------------------------------------------------------
echo.
echo   1. Entra a:  https://nodejs.org
echo   2. Baja la version que dice "LTS".
echo   3. Instalala apretando Siguiente hasta el final.
echo   4. Volve a hacer doble clic en este archivo.
echo.
pause
exit /b 1

:dato_vacio
echo.
echo ------------------------------------------------------------
echo   No escribiste el dato. No guarde nada.
echo   Volve a hacer doble clic para empezar de nuevo.
echo ------------------------------------------------------------
echo.
pause
exit /b 1

:error_guardar
echo.
echo ------------------------------------------------------------
echo   No pude guardar el archivo .env
echo ------------------------------------------------------------
echo   Puede ser que la carpeta este protegida o sea de solo lectura.
echo   Avisale a quien te armo el sistema y mostrale este mensaje.
echo.
pause
exit /b 1

:error_install
echo.
echo ------------------------------------------------------------
echo   Fallo la instalacion de dependencias
echo ------------------------------------------------------------
echo   Puede ser falta de internet. Revisa la conexion y volve a
echo   hacer doble clic.
echo.
pause
exit /b 1

:termino_con_error
echo ============================================================
echo   EL BOT TERMINO CON UN PROBLEMA
echo ============================================================
echo.
echo   Cosas para mirar, en orden:
echo.
echo   - Si dice "Fuera de horario permitido":
echo     correlo entre las 8 y las 18 h. Es a proposito.
echo.
echo   - Si dice "Login fallido":
echo     puede que cambiaste la Clave Unica. Borra el archivo .env
echo     de esta carpeta y volve a hacer doble clic para cargarla.
echo.
echo   - Si dice algo de red o "ERR_NAME_NOT_RESOLVED":
echo     el portal puede estar en mantenimiento. No lo corras cerca
echo     de las 23 h, que es cuando se actualiza.
echo.
echo   Saca una foto de esta ventana y mandala si no se resuelve.
echo.
pause
exit /b 1
