@echo off
REM ============================================================
REM CausasPro - CARGAR TANDA (25 causas) - para Programador de Tareas
REM ============================================================
REM
REM QUE HACE:
REM   Carga una tanda de 25 causas sin datos y para. Pensado para
REM   dejar programado en el Programador de Tareas de Windows y
REM   avanzar fuerte estos dias (hasta el 17-sep).
REM
REM PROTECCION ANTI-SOLAPE (importante):
REM   Si una tanda anterior AUN esta corriendo, esta se cancela sola.
REM   Nunca corren dos bots del mismo RUT a la vez (eso marca al bot).
REM
REM COMO USAR:
REM   1. Copia este archivo como "cargar-tanda.bat"
REM   2. Reemplaza los valores CAMBIAR_* con tus datos reales
REM   3. Programalo en el Programador de Tareas (ver BOT-PJUD.md)
REM   4. NUNCA subas el .bat con secretos a git (esta en .gitignore)
REM ============================================================

cd /d "%~dp0"

REM --- LOCK: evitar que dos tandas corran al mismo tiempo ---
REM Si existe el archivo de lock, otra tanda esta corriendo -> salir.
if exist "cargar-tanda.lock" (
  echo [%date% %time%] Otra tanda ya esta corriendo. Se cancela esta. >> cargar-tanda-log.txt
  exit /b 0
)
REM Crear el lock (marca de "corriendo").
echo running > "cargar-tanda.lock"

REM --- TUS DATOS (reemplazar) ---
set PJUD_RUT=CAMBIAR_POR_TU_RUT
set PJUD_PASSWORD=CAMBIAR_POR_CLAVE_UNICA_REAL
set NEXT_PUBLIC_SUPABASE_URL=https://ggwpikokzhckjpwyltye.supabase.co
set SUPABASE_SERVICE_ROLE_KEY=CAMBIAR_POR_SERVICE_ROLE_KEY

REM --- CONFIG DE LA TANDA ---
REM 25 causas por tanda.
set BOT_MAX_CAUSAS=25

REM RESPETAR horario laboral chileno (8-18h): NO seteamos SKIP_HOUR_CHECK.
REM El bot se auto-cancela fuera de ese horario (seguridad anti-deteccion).
REM Si necesitaras forzar fuera de horario, descomenta la siguiente linea:
REM set SKIP_HOUR_CHECK=1

REM Si la descarga de Chromium falla, usa tu Chrome instalado:
REM set BOT_USE_SYSTEM_CHROME=1

echo [%date% %time%] === Iniciando tanda de 25 causas === >> cargar-tanda-log.txt
call npm run bot >> cargar-tanda-log.txt 2>&1
echo [%date% %time%] === Tanda finalizada === >> cargar-tanda-log.txt
echo. >> cargar-tanda-log.txt

REM --- Liberar el lock SIEMPRE al terminar ---
del "cargar-tanda.lock" 2>nul

REM Sin "pause": para que corra desatendido desde el Programador de Tareas.
