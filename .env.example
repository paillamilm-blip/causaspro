# ============================================================
# CAUSASPRO - Variables de Entorno
# Copiar como .env.local y completar con tus datos reales
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://ggwpikokzhckjpwyltye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- Bot PJUD (Oficina Judicial Virtual) ---
PJUD_RUT=12345678-9
PJUD_PASSWORD=tu_contraseña_pjud

# --- Bot Config (opcional) ---
BOT_MAX_CAUSAS=25
BOT_MODE=normal

# Inventario del portal (responde "¿están todas mis causas?").
# Se activa con el lanzador bot-inventario.bat, que pone BOT_INVENTARIO=1 y
# hereda el resto. Correr 1 vez por mes, no en cada tanda.
# BOT_INVENTARIO=1            :: solo anota qué causas ve el portal (sin movimientos)
# BOT_INVENTARIO_MAX_FILAS=1200 :: corte de seguridad; si un año trae más filas,
#                                 el bot aborta sin guardar nada (probable CAPTCHA)
# BOT_INVENTARIO_SIN_RUT=1    :: barre SIN el filtro del RUT del curador. Evitalo:
#                                 es el listado completo del portal.

# Usar el Chrome ya instalado en vez de descargar el de Playwright.
# Si "npx playwright install chromium" falla o no querés bajar 130 MB, poné:
# BOT_USE_SYSTEM_CHROME=1
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Carpeta donde el bot guarda las capturas de error/debug.
# Por defecto: ./bot-capturas (dentro del proyecto). Funciona igual en Windows/Mac/Linux.
# BOT_SCREENSHOT_DIR=./bot-capturas

# Diagnóstico detallado en el log (lista de campos del formulario, tablas y filas del
# portal cuando una búsqueda falla). Útil para depurar en local. Ponlo en 0 para
# desactivarlo (recomendado en CI, para no volcar nombres de causas a logs públicos).
# BOT_DIAG=1


# ============================================================
# REPORTES WORD (.docx por causa)
# ------------------------------------------------------------
# El endpoint /api/reporte/[id] genera un .docx con datos SENSIBLES de la causa
# (NNA, adultos), por eso exige un token. Configurar al menos uno:
#
# Token público para el botón de descarga del frontend (secreto compartido simple,
# NO da acceso a la BD). Poné un valor largo y aleatorio.
NEXT_PUBLIC_REPORTE_TOKEN=
# (Opcional) Token para integraciones server-side. Si no se define, se usa
# REPORTE_API_TOKEN → BOT_API_TOKEN → SUPABASE_SERVICE_ROLE_KEY.
REPORTE_API_TOKEN=
# (Opcional) Membrete que aparece arriba del reporte (ej. nombre del estudio/curaduría).
REPORTE_MEMBRETE=
