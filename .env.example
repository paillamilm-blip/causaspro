# ============================================================
# CAUSASPRO - Variables de Entorno
# Copiar como .env.local y completar con tus datos reales
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://ggwpikokzhckjpwyltye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- Bot PJUD (Oficina Judicial Virtual) ---
PJUD_RUT=12345678-9
PJUD_PASSWORD=tu_contraseña_pjud

# --- Bot Config (opcional) ---
BOT_MAX_CAUSAS=25
BOT_MODE=normal

# Carpeta donde el bot guarda las capturas de error/debug.
# Por defecto: ./bot-capturas (dentro del proyecto). Funciona igual en Windows/Mac/Linux.
# BOT_SCREENSHOT_DIR=./bot-capturas

# Diagnóstico detallado en el log (lista de campos del formulario, tablas y filas del
# portal cuando una búsqueda falla). Útil para depurar en local. Ponlo en 0 para
# desactivarlo (recomendado en CI, para no volcar nombres de causas a logs públicos).
# BOT_DIAG=1
